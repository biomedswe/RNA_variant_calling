// =============================
// PARAMETER DEFINITIONS
// =============================
params {

  // Concatenate fastq files
  raw_fastq_input_dir     = 'Data/HTL2_fastq_files'
  concat_fastq_dir        = 'Data/HTL2_concatenated_fastq_files'
  log_dir                 = '/gpfs/gpfs0/Active_Projects/POE_HPI/Private/ASE_analysis/Human_adult_pancreatic_islets_HTL2/RNA_variant_calling/Logs'

  // FastQC
  fastqc_dir              = 'QC/raw_fastqc_reports'

  // MultiQC
  multiqc_raw_dir              = 'QC/raw_multiqc_report'
  multiqc_trimmed_dir          = 'QC/trimmed_multiqc_report'

  // Trimgalore
  trimgalore_input_dir    = 'Data/HTL2_concatenated_fastq_files'
  trimgalore_output_dir   = 'Processed_files/1.HTL2_fastq_files_QC_trimmed'

  // PICARD fastqToSam
  fastqtosam_output_dir   = 'Processed_files/2.FastqToSam'

  // STAR alignment
  align_reads_output_dir  = 'Processed_files/3.AlignReads'

  // MergeBamAlignment
  merged_output_dir     = 'Processed_files/4.MergeBamAlignment'

  // MarkDuplicates
  markduplicates_output_dir = 'Processed_files/5.MarkDuplicates'

  // SplitNCigarReads
  splitncigarreads_ouput_dir = 'Processed_files/6.SplitNCigarReads'

  // BaseRecalibrator
  baserecalibrator_ouput_dir = 'Processed_files/7.BaseRecalibrator'

  // Apply BaseRecalibration
  applybqsr_ouput_dir = 'Processed_files/8.ApplyBQSR'

  // HaplotypeCaller
  haplotypecaller_ouput_dir = 'Processed_files/9.HaplotypeCaller'

  // VariantFiltration
  variantfiltration_ouput_dir = 'Processed_files/10.VariantFiltration'

  // FindIntersectingSNPs
  findintersectingsnps_ouput_dir = 'Processed_files/11.FindIntersectingSNPs'
  
  publish_mode            = 'symlink'  // or 'copy'

  // Path to the STAR genome directory
  star_genome              = '/gpfs/gpfs0/Active_Projects/POE_HPI/Private/ASE_analysis/Human_adult_pancreatic_islets_HTL2/RNA_variant_calling/Processed_files/STAR_genome_GRCh38_100_gencode_v43/'
  
  // Path to the reference genome
  reference_genome        = '/ludc/Active_Projects/POE_HPI/Private/ASE_analysis/Human_adult_pancreatic_islets_HTL/RNA_variant_calling/Data/GRCh38.v43_primary_assembly/GRCh38.primary_assembly.genome.fa'

  // SNPs and indels VCF file
  snp_sites         = '/ludc/Active_Projects/POE_HPI/Private/ASE_analysis/Human_adult_pancreatic_islets_HTL/RNA_variant_calling/Ref_Data/'

  // Path to tmp directory
  tmp_dir                 = '/gpfs/gpfs0/Active_Projects/POE_HPI/Private/ASE_analysis/Human_adult_pancreatic_islets_HTL2/RNA_variant_calling/Processed_files/TMP'

  // Script folder
  script_dir              = '/gpfs/gpfs0/Active_Projects/POE_HPI/Private/ASE_analysis/Human_adult_pancreatic_islets_HTL2/RNA_variant_calling/Scripts'

  // WASP directory
  wasp_dir                = '/gpfs/gpfs0/Active_Projects/POE_HPI/Private/ASE_analysis/Human_adult_pancreatic_islets_HTL2/RNA_variant_calling/Scripts/WASP/WASP'
}

// =============================
// CLUSTER EXECUTION SETTINGS
// ============================

process {
  executor = 'condor'
  clusterOptions = '''
    log     = $(Cluster).log
  '''
}
// =============================
// PROCESS-SPECIFIC RESOURCES
// =============================
process {

  // --- concat_fastq process ---
  withName: Concatenating_fastq {
    maxForks = 100
    cpus    = 1
    memory  = '2 GB'
    time    = '2h'
    publishDir = [ path: params.concat_fastq_dir, mode: params.publish_mode ]
   
  }

  // --- fastqc process ---
  withName: FastQC {
    maxForks = 100
    cpus    = 1
    memory  = '4 GB'
    time    = '1h'
    publishDir = [ path: params.fastqc_dir, mode: params.publish_mode ]
  }

    // --- multiqc raw process ---
  withName: multiqc_raw {
    cpus    = 1
    memory  = '4 GB'
    time    = '2h'
    publishDir = [ path: params.multiqc_raw_dir, mode: params.publish_mode ]
  }

     // --- multiqc trimmed process ---
  withName: multiqc_trimmed {
    cpus    = 1
    memory  = '4 GB'
    time    = '2h'
    publishDir = [ path: params.multiqc_trimmed_dir, mode: params.publish_mode ]
  }

    // --- trimgalore process ---
  withName: trim_galore {
    maxForks = 60
    cpus        = 4
    memory      = '4 GB'
    time        = '10h'
    publishDir  = [ path: params.trimgalore_output_dir, mode: params.publish_mode ]
  }

// --- AlignReads process ---
  withName: AlignReads {
    maxForks = 30
    cpus    = 8
    memory  = '50 GB'
    time    = '10h'
    publishDir  = [ path: params.align_reads_output_dir, mode: params.publish_mode ]
  }

  // --- MarkDuplicates process ---
  withName: MarkDuplicates {
    maxForks = 50
    cpus    = 1
    memory  = '30 GB'
    time    = '10h'
    publishDir  = [ path: params.markduplicates_output_dir, mode: params.publish_mode ]
  }

  // --- SplitNCigarReads process ---
  withName: SplitNCigarReads {
    maxForks = 100
    cpus    = 1
    memory  = '10 GB'
    time    = '10h'
    publishDir  = [ path: params.splitncigarreads_ouput_dir, mode: params.publish_mode ]
  }

  // --- BaseRecalibrator process ---
  withName: BaseRecalibrator {
    maxForks = 100
    cpus    = 1
    memory  = '10 GB'
    time    = '10h'
    publishDir  = [ path: params.baserecalibrator_ouput_dir, mode: params.publish_mode ]
  }
  
  // --- Apply BaseRecalibration process ---
  withName: ApplyBQSR {
    maxForks = 100
    cpus    = 1
    memory  = '10 GB'
    time    = '10h'
    publishDir  = [ path: params.applybqsr_ouput_dir, mode: params.publish_mode ]
  }

   // --- HaplotypeCaller process ---
  withName: HaplotypeCaller {
    maxForks = 100
    cpus    = 1
    memory  = '10 GB'
    time    = '10h'
    publishDir  = [ path: params.haplotypecaller_ouput_dir, mode: params.publish_mode ]
  }

  // --- VariantFiltration process ---
  withName: VariantFiltration {
    maxForks = 100
    cpus    = 1
    memory  = '10 GB'
    time    = '10h'
    publishDir  = [ path: params.variantfiltration_ouput_dir, mode: params.publish_mode ]
  }

  // --- FindIntersectingSNPs process ---
  withName: FindIntersectingSNPs {
    maxForks = 100
    cpus    = 1
    memory  = '10 GB'
    time    = '10h'
    publishDir  = [ path: params.findintersectingsnps_ouput_dir, mode: params.publish_mode ]
  }


}
