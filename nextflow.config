// Define reusable parameters for input/output directories
params {
  input_dir  = 'Data/HTL2_fastq_files'            // Input: folder with raw FASTQ files
  output_dir = 'Data/concatenated_fastq_files'    // Output: folder for merged FASTQ files
  log_dir    = 'Logs/concatenate_fastq_files'     // Logs: folder for HTcondor log files
}

// Set HTCondor as the executor (cluster scheduler)
process.executor = 'condor'

// Default resource requests for all processes
process {
  cpus = 1            // Each job uses 1 core
  memory = '2 GB'     // Request 2 GB of RAM
  time = '1h'         // Walltime limit of 1 hour per job
}
