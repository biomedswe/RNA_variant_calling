// =============================
// PARAMETER DEFINITIONS
// =============================
params {

  // Concatenate fastq files
  raw_fastq_input_dir     = 'Data/HTL2_fastq_files'
  concat_fastq_dir        = 'Data/HTL2_concatenate_fastq_files'
  log_dir                 = 'Logs/HTL2_concatenate_fastq_files'

  // FastQC
  fastqc_dir              = 'QC/raw_fastqc_reports'

  // MultiQC
  multiqc_raw_dir              = 'QC/raw_multiqc_report'
  multiqc_trimmed_dir          = 'QC/trimmed_multiqc_report'

  // Trimgalore
  trimgalore_input_dir    = 'Data/HTL2_concatenated_fastq_files'
  trimgalore_output_dir   = 'Processed_files/HTL2_fastq_files_QC_trimmed'

  // PICARD fastqToSam
  fastqtosam_output_dir   = 'Processed_files/1.FastqToSam'
  publish_mode            = 'symlink'  // or 'copy'

  // Path to the reference genome
  reference_genome        = '/ludc/Active_Projects/POE_HPI/Private/ASE_analysis/Human_adult_pancreatic_islets_HTL/RNA_variant_calling/Data/GRCh38.v43_primary_assembly/GRCh38.primary_assembly.genome.fa'

  // Path to tmp directory
  tmp_dir                 = '/gpfs/gpfs0/Active_Projects/POE_HPI/Private/ASE_analysis/Human_adult_pancreatic_islets_HTL2/RNA_variant_calling/Processed_files/TMP'
}

// =============================
// CLUSTER EXECUTION SETTINGS
// =============================
process.executor = 'condor'

// =============================
// PROCESS-SPECIFIC RESOURCES
// =============================
process {

  // --- concat_fastq process ---
  withName: concat_fastq {
    cpus    = 1
    memory  = '2 GB'
    time    = '2h'
    publishDir = [ path: params.concat_fastq_dir, mode: params.publish_mode ]
  }

  // --- fastqc process ---
  withName: fastqc {
    cpus    = 1
    memory  = '4 GB'
    time    = '1h'
    publishDir = [ path: params.fastqc_dir, mode: params.publish_mode ]
  }

    // --- multiqc raw process ---
  withName: multiqc_raw {
    cpus    = 1
    memory  = '4 GB'
    time    = '2h'
    publishDir = [ path: params.multiqc_raw_dir, mode: params.publish_mode ]
  }

     // --- multiqc trimmed process ---
  withName: multiqc_trimmed {
    cpus    = 1
    memory  = '4 GB'
    time    = '2h'
    publishDir = [ path: params.multiqc_trimmed_dir, mode: params.publish_mode ]
  }

    // --- trimgalore process ---
  withName: trim_galore {
    maxForks = 60
    cpus        = 4
    memory      = '4 GB'
    time        = '10h'
    publishDir  = [ path: params.trimgalore_output_dir, mode: params.publish_mode ]
  }

  // --- fastqtosam process ---
  withName: fastqtosam {
    cpus    = 1
    memory  = '3 GB'
    time    = '10h'
    publishDir = [ path: params.fastqtosam_output_dir, mode: params.publish_mode ]
  }

  
}
